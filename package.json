{
  "name": "@zovo/webext-devtools",
  "version": "1.0.0",
  "description": "Promise-based, fully typed wrapper for the Chrome DevTools API — panels, inspected window, network, and sidebars. Part of @zovo/webext.",
  "main": "./dist/index.js",
  "scripts": {
    "test": "vitest run",
    "build": "tsc",
    "prepare": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theluckystrike/webext-devtools.git"
  },
  "keywords": [
    "chrome-devtools",
    "chrome-extension",
    "browser-extension",
    "devtools",
    "devtools-protocol",
    "manifest-v3",
    "webextension",
    "npm-package"
  ],
  "author": "theluckystrike",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/theluckystrike/webext-devtools/issues"
  },
  "homepage": "https://github.com/theluckystrike/webext-devtools#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
